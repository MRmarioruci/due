# Copy to .env.local (git-ignored) and fill in.
# due-api reads the bills (see ../due-api). Locally: `npm run serve` there,
# then use your laptop's Wi-Fi address so the phone can reach it.
EXPO_PUBLIC_DUE_API_URL=http://192.168.1.9:3001
# Must equal DUE_APP_KEY in due-api.
EXPO_PUBLIC_DUE_APP_KEY=
